# =============================================================================
# Infra Agents Next — environment template
# Copy to `.env.local` and fill in values. Next.js loads `.env.local` into
# `process.env` for server code (`src/server/auth/config.ts` and Route Handlers).
# Never commit real secrets. Production should use Secrets / ConfigMaps.
# =============================================================================

# -----------------------------------------------------------------------------
# Auth0
# -----------------------------------------------------------------------------

# Auth0 tenant domain (no protocol prefix)
AUTH0_DOMAIN=

# Expected audience claim in access tokens
AUTH0_AUDIENCE=

# M2M application credentials for Auth0 Management API
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# Default Auth0 Organization to assign new users to
AUTH0_DEFAULT_ORG_ID=

# Auth0 RBAC role ID for the default "viewer" role (e.g. rol_abc123).
# Required for auto-assigning viewer to new users on first login.
# Find in Auth0 Dashboard -> User Management -> Roles -> viewer -> Role ID.
# M2M client also needs: read:roles, update:users,
# update:users_app_metadata, create:role_members.
AUTH0_VIEWER_ROLE_ID=

# BFF OAuth application (Regular Web App — confidential client)
# Auth0 Allowed Callback URL must include:
#   {BFF_BASE_URL}/auth-api/auth/callback
AUTH0_BFF_CLIENT_ID=
AUTH0_BFF_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Session (CRITICAL for multi-replica)
# -----------------------------------------------------------------------------

# Session cookie signing key (32+ random characters).
# MUST be identical across all replicas.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Name of the session cookie (optional, default: ia_session)
SESSION_COOKIE_NAME=ia_session

# Session TTL in seconds (optional, default: 2592000 = 30 days)
SESSION_MAX_AGE=2592000

# -----------------------------------------------------------------------------
# Cookies
# -----------------------------------------------------------------------------

# Cookie domain (optional). Leave empty for auto-detection from BFF_BASE_URL.
# For localhost / IP access, leave empty (host-only cookies).
# Production example: .example.com
COOKIE_DOMAIN=

# Force Secure cookie flag (optional). Leave empty for auto-detect
# (true when BFF_BASE_URL is https). Set to true or false to override.
COOKIE_SECURE_OVERRIDE=

# -----------------------------------------------------------------------------
# Redis (REQUIRED for multi-replica; optional for single-process local dev)
# -----------------------------------------------------------------------------

# Format: redis://[user:password@]host:port/db
# Leave empty for in-memory session + PKCE storage (single instance only).
REDIS_URL=

# Key prefix for session storage (optional, default: ia:session:)
REDIS_KEY_PREFIX=ia:session:

# -----------------------------------------------------------------------------
# App / OAuth redirects
# -----------------------------------------------------------------------------

# Public origin users type in the browser (OAuth redirects + cookie scope).
# Must match Auth0 Allowed Callback / Logout URLs.
# Local Next:  http://localhost:3000
# Production:  https://app.example.com
BFF_BASE_URL=http://localhost:3000

# Legacy Python auth-client port. Unused by Next Route Handlers under
# /auth-api/**; kept for the privacy-policy rewrite to localhost:3001 only.
AUTH_API_PORT=3001

# -----------------------------------------------------------------------------
# Compliance / audit logging (optional)
# -----------------------------------------------------------------------------

# PostgreSQL URL for the audit_log table. Without this, auth audit events
# are silently skipped. Falls back to DB_URL if COMPLIANCE_DB_URL is unset.
# Format: postgresql://user:password@host:port/dbname
COMPLIANCE_DB_URL=
DB_URL=

# -----------------------------------------------------------------------------
# Frontend (optional)
# -----------------------------------------------------------------------------

# Query-trace agent frame protocol: v2 (default) or v1
# NEXT_PUBLIC_AGENT_FRAME_PROTOCOL=v2

# -----------------------------------------------------------------------------
# Playwright E2E (optional; not loaded by Next — set in shell / CI)
# -----------------------------------------------------------------------------

# BASE_URL=http://localhost:3000
# HEADLESS=true
