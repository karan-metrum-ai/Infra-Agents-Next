cd "$(dirname "$0")/.." || exit 1

staged_files=$(git diff --cached --name-only --diff-filter=ACMR --relative -- \
  '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' '*.json' '*.css')

if [ -z "$staged_files" ]; then
  exit 0
fi

lint_status=0
printf '%s\n' "$staged_files" | xargs pnpm exec oxlint --fix || lint_status=$?

printf '%s\n' "$staged_files" | xargs pnpm exec oxfmt --write

printf '%s\n' "$staged_files" | xargs git add --

if [ "$lint_status" -ne 0 ]; then
  echo "oxlint found issues that could not be auto-fixed — commit aborted." >&2
  exit 1
fi

exit 0
