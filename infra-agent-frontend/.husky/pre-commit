cd "$(dirname "$0")/.." || exit 1

lint_files=$(git diff --cached --name-only --diff-filter=ACMR --relative -- \
  '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs')

fmt_files=$(git diff --cached --name-only --diff-filter=ACMR --relative -- \
  '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' '*.json' '*.css')

if [ -z "$fmt_files" ]; then
  exit 0
fi

lint_status=0
if [ -n "$lint_files" ]; then
  printf '%s\n' "$lint_files" | xargs pnpm exec oxlint --fix || lint_status=$?
fi

printf '%s\n' "$fmt_files" | xargs pnpm exec oxfmt --write

printf '%s\n' "$fmt_files" | xargs git add --

if [ "$lint_status" -ne 0 ]; then
  echo "oxlint found issues that could not be auto-fixed — commit aborted." >&2
  exit 1
fi

exit 0
